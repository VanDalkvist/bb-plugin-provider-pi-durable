{
  "name": "bb-plugin-provider-pi-durable",
  "version": "0.3.22",
  "type": "module",
  "engines": {
    "bb": ">=0.47.1",
    "bbPluginSdk": ">=0.6.79"
  },
  "bb": {
    "name": "Pi Durable",
    "description": "Run BB threads with Pi Durable ACID SQLite runtime.",
    "branding": {
      "icon": "./icons/pi-durable.svg"
    },
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "pi-durable",
        "displayName": "Pi Durable"
      }
    ],
    "server": "./server.ts",
    "host": "./src/host/index.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@get-bb/plugin-sdk": "0.6.79",
    "@types/proper-lockfile": "^4.1.4",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.6.6"
  },
  "overrides": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "undici": "8.12.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build:runner": "node scripts/build-runner.mjs",
    "build:host": "bb plugin build",
    "build": "node scripts/build-runner.mjs && bb plugin build",
    "test": "npm run test:contracts && node --test tests/*.test.ts && tsx --test tests/ui/*.test.ts",
    "test:contracts": "tsc --noEmit -p tsconfig.contract-tests.json && node scripts/check-negative-contracts.mjs",
    "doctor": "node scripts/doctor.mjs"
  }
}
