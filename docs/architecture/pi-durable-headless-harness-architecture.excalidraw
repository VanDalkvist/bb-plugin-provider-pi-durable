    {
      "id": "footer_rules_lbl",
      "type": "text",
      "x": 319,
      "y": 750,
      "width": 1162,
      "height": 100,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": "footer_rules",
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 16,
      "frameId": null,
      "groupIds": [],
      "index": "av",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "ТРИ ГЛАВНЫХ ПРАВИЛА ЭТОЙ АРХИТЕКТУРЫ:\n\n1. ДВИЖОК ОДИН: Мы не пишем второй движок для Андрея. Движок живет у тебя, а Андрей делает только переходник.\n2. ВЫДЕРНУЛ ПРОВОД — РАБОТА ИДЕТ: Если закрыть ноутбук или окно программы, движок не умирает, а доделывает задачу в фоне.\n3. В СЕЙФ ПИШЕТ ТОЛЬКО ОДИН: Никакие экраны не имеют права сами менять файл памяти. В базу пишет строго один Движок.",
      "roughness": 1,
      "roundness": null,
      "seed": 1519056727,
      "strokeColor": "#92400e",
      "strokeStyle": "solid",
      "strokeWidth": 1,
      "text": "ТРИ ГЛАВНЫХ ПРАВИЛА ЭТОЙ АРХИТЕКТУРЫ:\n\n1. ДВИЖОК ОДИН: Мы не пишем второй движок для Андрея. Движок живет у тебя, а Андрей делает только переходник.\n2. ВЫДЕРНУЛ ПРОВОД — РАБОТА ИДЕТ: Если закрыть ноутбук или окно программы, движок не умирает, а доделывает задачу в фоне.\n3. В СЕЙФ ПИШЕТ ТОЛЬКО ОДИН: Никакие экраны не имеют права сами менять файл памяти. В базу пишет строго один Движок.",
      "textAlign": "center",
      "updated": 1,
      "version": 1,
      "versionNonce": 948299125,
      "verticalAlign": "middle"
    }
